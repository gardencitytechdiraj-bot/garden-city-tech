# Public site settings
VITE_SITE_URL=https://gardencitytech.net

# Server-side application storage. Keep these values in Vercel Environment Variables
# or Replit Secrets; never expose them with the VITE_ prefix.
# Preferred: OAuth credentials created under info@gardencitytech.net.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional legacy fallback. Do not use this when OAuth is configured above.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=1iujAXfgToma4JldDsLC4c_d2G86bXjk-
GOOGLE_SHEET_ID=1bUYEIVue4dD9mdu11IVeP-kd6Pj3ihQ5mv4YvR5yUdA
GOOGLE_SHEET_RANGE=Sheet1!A:T

# Notification mailer (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=info@gardencitytech.net
NOTIFICATION_EMAIL=info@gardencitytech.net

# Protected admin login. These are server-only values; never prefix them with VITE_.
# The username used on /admin/login.
ADMIN_USERNAME=admin
# A bcrypt hash of the admin password. Store only the hash, never the plaintext password.
ADMIN_PASSWORD_HASH=
# A long random secret used to sign the httpOnly admin session cookie.
ADMIN_SESSION_SECRET=

# Optional legacy access key retained for migration compatibility with older admin clients.
ADMIN_PANEL_KEY=

# Set only in production environments. Local development intentionally uses in-memory storage.
NODE_ENV=development
